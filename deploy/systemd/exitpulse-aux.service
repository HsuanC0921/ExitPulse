[Unit]
Description=ExitPulse Auxiliary Data Auto Update (Holidays & Station Info)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/exitpulse
EnvironmentFile=/opt/exitpulse/.env
ExecStart=/opt/exitpulse/deploy/update-all.sh aux
Nice=10
StandardOutput=journal
StandardError=journal
