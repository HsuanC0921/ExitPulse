# Production Compose. Generate a unique password before starting PostgreSQL.
POSTGRES_USER=exitpulse
POSTGRES_DB=exitpulse
POSTGRES_PASSWORD=

# The host reverse proxy connects to this loopback port.
# EXITPULSE_WEB_PORT=5080
# EXITPULSE_WEB_RELEASES=/srv/exitpulse/releases

# Optional failure alerts for deploy/update-all.sh (tools/notify.py)
# EXITPULSE_ALERT_WEBHOOK=
# EXITPULSE_TELEGRAM_BOT_TOKEN=
# EXITPULSE_TELEGRAM_CHAT_ID=

# Optional read-only database role for the API. Run deploy/create-readonly-role.sh to create it and fill these in.
# EXITPULSE_API_USER=exitpulse_api
# EXITPULSE_API_PASSWORD=

# Per-client rate limit for /api/ (requests per minute, burst). Set the first to 0 to disable.
# EXITPULSE_RATE_PER_MINUTE=240
# EXITPULSE_RATE_BURST=80
